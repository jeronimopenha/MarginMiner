{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Carteira: Streamlit",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "cwd": "${workspaceFolder}",
      "args": [
        "run",
        "${workspaceFolder}/app.py",
        "--server.headless=true",
        "--server.port=8501",
        "--server.runOnSave=true",
        "--server.fileWatcherType=poll"
      ],
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": true,
    }
  ]
}
